@router.get("/jobs")
async def get_jobs(
    corridor_id: int | None = None,
    severity: str | None = None,
    job_status: str | None = None,
    db: AsyncSession = Depends(get_db),
    _: User = Depends(require_manager),
):
    query = select(MaintenanceJob)

    if corridor_id is not None:
        segment_ids_result = await db.execute(
            select(TrackSegment.id).where(
                TrackSegment.corridor_id == corridor_id
            )
        )

        segment_ids = list(
            segment_ids_result.scalars().all()
        )

        if not segment_ids:
            return {
                "count": 0,
                "jobs": [],
            }

        query = query.where(
            MaintenanceJob.track_segment_id.in_(
                segment_ids
            )
        )

    if severity:
        query = query.where(
            MaintenanceJob.severity == severity
        )

    if job_status:
        query = query.where(
            MaintenanceJob.status == job_status
        )

    query = query.order_by(
        MaintenanceJob.priority_score.desc(),
        MaintenanceJob.id.asc(),
    )

    result = await db.execute(query)
    jobs = result.scalars().all()

    response = []

    for job in jobs:
        response.append(
            await job_to_dict(
                db,
                job,
            )
        )

    return {
        "count": len(response),
        "jobs": response,
    }


